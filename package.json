{
  "name": "i-know-that-voice-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check apps packages",
    "lint:fix": "biome check --write apps packages",
    "format": "biome format --write apps packages",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@biomejs/biome": "^2.3.2",
    "lefthook": "^2.0.2",
    "turbo": "^2.6.0"
  },
  "catalog": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
